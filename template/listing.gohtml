<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Liste des formations Zenika</title>
  <script>
    document.documentElement.classList.add("js");
    try {
      var t = localStorage.getItem("theme");
      if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
  <style>
    :root {
      color-scheme: light dark;
      --bg: light-dark(#f5f5f7, #121214);
      --card: light-dark(#ffffff, #1e1e22);
      --text: light-dark(#1b1b1f, #f3f3f5);
      --muted: light-dark(#4b4b55, #c4c4cc);
      --border: light-dark(#6b6b76, #9a9aa6);
      --accent: light-dark(#c8000f, #ff7a82);
      --shadow: light-dark(0 1px 3px rgba(0, 0, 0, .15), none);
    }
    :root[data-theme="light"] { color-scheme: light; }
    :root[data-theme="dark"] { color-scheme: dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      font-size: 1.125rem;
      line-height: 1.5;
    }
    header, main {
      max-width: 72rem;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    header { padding-top: 3rem; padding-bottom: 1rem; }
    h1 {
      margin: 0 0 .5rem;
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      line-height: 1.2;
    }
    h1::after {
      content: "";
      display: block;
      width: 4rem;
      height: .3rem;
      margin-top: .75rem;
      background: var(--accent);
    }
    header p { margin: 0; color: var(--muted); }
    .theme { display: none; margin: 1.5rem 0 0; padding: 0; border: 0; }
    .js .theme { display: block; }
    .theme legend { padding: 0; font-size: .875rem; color: var(--muted); }
    .theme div {
      display: inline-flex;
      margin-top: .25rem;
      border: 1px solid var(--border);
      border-radius: .5rem;
      overflow: hidden;
    }
    .theme button {
      font: inherit;
      font-size: .875rem;
      padding: .5rem 1rem;
      color: var(--text);
      background: var(--card);
      border: 0;
      border-right: 1px solid var(--border);
      cursor: pointer;
    }
    .theme button:last-child { border-right: 0; }
    .theme button[aria-pressed="true"] { background: var(--text); color: var(--bg); font-weight: 600; }
    .theme button:focus-visible { outline: .2rem solid var(--accent); outline-offset: -.2rem; }
    ul {
      list-style: none;
      margin: 0;
      padding: 1.5rem 0 3rem;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
      gap: 1rem;
    }
    li { display: flex; }
    a {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: .75rem;
      min-height: 7rem;
      padding: 1.25rem;
      color: var(--text);
      text-decoration: none;
      background: var(--card);
      border: 1px solid var(--border);
      border-top: .3rem solid var(--accent);
      border-radius: .5rem;
      box-shadow: var(--shadow);
      transition: transform .15s ease, border-color .15s ease;
    }
    a:hover { transform: translateY(-2px); border-color: var(--accent); }
    a:hover .title { text-decoration: underline; text-decoration-thickness: .15rem; }
    a:focus-visible { outline: .2rem solid var(--text); outline-offset: .2rem; }
    .title { font-size: 1.25rem; font-weight: 600; }
    .hint { font-size: .875rem; color: var(--muted); }
    .empty { padding: 1.5rem 0 3rem; color: var(--muted); }
    @media (prefers-reduced-motion: reduce) {
      a { transition: none; }
      a:hover { transform: none; }
    }
  </style>
</head>
<body>
  <header>
    <h1>Formations Zenika</h1>
    <p>Choisissez une formation pour accéder à ses supports.</p>
    <fieldset class="theme">
      <legend>Thème</legend>
      <div>
        <button type="button" data-theme-choice="system">Système</button>
        <button type="button" data-theme-choice="light">Clair</button>
        <button type="button" data-theme-choice="dark">Sombre</button>
      </div>
    </fieldset>
  </header>
  <main>
    <ul>
      {{ range $service := .Services }}
      {{ if ne $service.ID "default" }}
      <li>
        <a href="{{ $service.URL }}" target="_blank" rel="noopener">
          <span class="title">{{ $service.Title }}</span>
          <span class="hint">Ouvre dans un nouvel onglet</span>
        </a>
      </li>
      {{ end }}
      {{ else }}
      <li class="empty">Aucune formation disponible pour le moment.</li>
      {{ end }}
    </ul>
  </main>
  <script>
    (function () {
      var root = document.documentElement;
      var buttons = document.querySelectorAll("[data-theme-choice]");
      function show() {
        var current = root.dataset.theme || "system";
        buttons.forEach(function (b) {
          b.setAttribute("aria-pressed", String(b.dataset.themeChoice === current));
        });
      }
      buttons.forEach(function (b) {
        b.addEventListener("click", function () {
          var choice = b.dataset.themeChoice;
          if (choice === "system") delete root.dataset.theme;
          else root.dataset.theme = choice;
          try {
            if (choice === "system") localStorage.removeItem("theme");
            else localStorage.setItem("theme", choice);
          } catch (e) {}
          show();
        });
      });
      show();
    })();
  </script>
</body>
</html>
